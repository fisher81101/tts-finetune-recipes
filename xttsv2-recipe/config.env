# =============================================================================
# XTTS v2 Fine-Tuning Configuration
# Edit the values in this file, then run:
#   source config.env && python train.py          (single GPU)
#   source config.env && python train.py --multi  (multi-GPU DDP)
# =============================================================================

# ── PATHS ────────────────────────────────────────────────────────────────────
# Directory containing wavs/ and metadata.csv
DATASET_PATH=./dataset

# Path to the metadata CSV  (pipe-delimited: id|text, no header)
METADATA_FILE=./dataset/metadata.csv

# Reference speaker WAV used for test-sentence synthesis during training
# Should be the same speaker as your training data, 5-10 sec, 24 kHz
SPEAKER_REFERENCE=./dataset/reference.wav

# Where training checkpoints and logs will be saved
OUT_PATH=./output

# ── HARDWARE ─────────────────────────────────────────────────────────────────
# Comma-separated GPU indices. Single GPU: "0"  |  Two GPUs: "0,1"
CUDA_VISIBLE_DEVICES=0

# OpenMP threads per process (2 is safe for most setups)
OMP_NUM_THREADS=2

# ── TRAINING CORE ─────────────────────────────────────────────────────────────
# Number of full passes over the dataset
XTTS_EPOCHS=30

# Per-GPU batch size
# Single 24GB GPU: 4  |  Single 16GB GPU: 2  |  OOM? reduce to 1
XTTS_BATCH_SIZE=4

# Gradient accumulation steps
# Effective batch = BATCH_SIZE * GRAD_ACCUM_STEPS * N_GPUS
# Try to keep effective batch >= 252 (e.g. 4 * 16 * 1 = 64... or 4 * 16 * 2 = 128)
XTTS_GRAD_ACCUM_STEPS=16

# Learning rate  (default 5e-6 works well for most fine-tuning runs)
XTTS_LR=5e-6

# AdamW weight decay
XTTS_WEIGHT_DECAY=1e-2

# Maximum audio clip length in samples at 22050 Hz
# 350000 = ~15.9 sec | 255995 = ~11.6 sec | reduce if OOM during data loading
XTTS_MAX_WAV_LENGTH=350000

# ── EVAL & LOGGING ────────────────────────────────────────────────────────────
# Fraction of data reserved for validation (0.1 = 10%)
XTTS_EVAL_SPLIT_SIZE=0.1

# Hard cap on validation set size (avoids very long eval on large datasets)
XTTS_EVAL_SPLIT_MAX_SIZE=80

# Save a checkpoint every N optimizer steps
XTTS_SAVE_STEP=200

# Log model weights to tensorboard every N steps
XTTS_LOG_MODEL_STEP=400

# Print training loss every N steps
XTTS_PRINT_STEP=50

# ── LANGUAGE ─────────────────────────────────────────────────────────────────
# Language code for your dataset.  en = English  |  fr = French  |  etc.
LANGUAGE=en

# ── TEST SENTENCES ────────────────────────────────────────────────────────────
# These sentences are synthesized at each eval step so you can hear progress.
# Replace them with sentences from your own domain.
XTTS_TEST_TEXT_1=The quick brown fox jumps over the lazy dog.
XTTS_TEST_TEXT_2=Hello, this is a fine-tuned XTTS voice speaking.

# ── ADVANCED (rarely need changing) ──────────────────────────────────────────
XTTS_BATCH_GROUP_SIZE=32
XTTS_EVAL_BATCH_SIZE=
XTTS_NUM_LOADER_WORKERS=8
XTTS_SAVE_N_CHECKPOINTS=1
XTTS_LR_MILESTONES=900,1400,1850
XTTS_LR_GAMMA=0.5
XTTS_PLOT_STEP=100
